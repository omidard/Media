  "verification": "paper-verified (complete recipe; cited + supplementary sources chased)",
  "verification_evidence": "20 mM glucose, 40 mM glycerol, or 24 mM xylose as sole carbon source",
  "verification_confidence": "medium",
  "base_medium": "Mineral salts medium (MSM) of Hartmans et al. 1989 (Appl. Environ. Microbiol. 55:2850-2855), as used for Pseudomonas taiwanensis; here with 5-fold phosphate buffer and 2-fold mineral-salts stock.",
  "recuration": {
   "date": "2026-07-16",
   "round": "complete-recipe (cited+supplementary chased)",
   "status": "corrected",
   "confidence": "high",
   "sources_chased": [
    {
     "what": "target paper main text (PMC6882275) - modifications to Hartmans MSM (2x mineral salts, 5x phosphate)",
     "obtained": true,
     "how": "WebFetch pmc.ncbi.nlm.nih.gov/articles/PMC6882275/",
     "added": [
      "exact 2x salt concentrations",
      "5-fold phosphate (111.5 mM K2HPO4, 68 mM NaH2PO4)"
     ]
    },
    {
     "what": "base Hartmans 1989 MSM full composition (missing EDTA chelator, (NH4)2SO4 amount, 20 mM glucose baseline)",
     "obtained": true,
     "how": "WebFetch Frontiers fbioe.2019.00130 and fbioe.2019.00312 (same Blank/Schmid group, verbatim MSM recipe per Hartmans 1989); original Hartmans 1989 AEM article not directly retrievable but recipe cross-confirmed across 3 same-lineage sources",
     "added": [
      "EDTA 10 mg/L",
      "(NH4)2SO4 2 g/L",
      "confirmed 20 mM glucose carbon source"
     ]
    }
   ],
   "missing_before": [
    "EDTA (10 mg/L chelator)"
   ],
   "corrections": [],
   "notes": "MSM for Pseudomonas taiwanensis grown aerobically in shake flasks / well plates at pH 7.0. Union recipe = Hartmans 1989 base + this paper's 5x phosphate buffer + 2x mineral-salts stock + 20 mM glucose. The paper's explicit 2x list omits EDTA; EDTA is recovered from the base recipe at its 1x value of 10 mg/L (whether it was also doubled is not stated). Note: the current model exchange set carried a spurious Fe3+ (EX_fe3_e) - the actual medium supplies only ferrous iron as FeSO4.7H2O; oxygen corrected from 'facultative' to aerobic."
  },

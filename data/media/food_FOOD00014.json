 "name": "Custard apple (food medium)",
 "category": "food",
 "organism_scope": "food microbiome / general",
 "aerobic": true,
 "description": "Food-derived medium: metabolizable components of Custard apple (Annona reticulata) [Fruits] from FooDB, plus a standard M9 mineral base. Organic components use presence-based uptake bounds; FooDB content retained. Measured compounds with no BiGG exchange are listed under uncovered.",
 "namespace": "bigg",
 "provenance": {
  "source_type": "database",
  "citation": "FooDB v2020-04-07 (Wishart DS et al., foodb.ca). Content sources: DUKE, PHENOL EXPLORER, USDA.",
  "doi": "",
  "url": "https://foodb.ca/downloads",
  "notes": "Organic components mapped from FooDB compounds to BiGG via InChIKey/name. Mineral base added. Bounds presence-based; foodb_content retained. Unmapped measured compounds kept in uncovered (v2 completeness fix). IMPORTANT: composition values are taken from the archived FooDB 2020-04-07 CSV data release; FooDB's live food page no longer displays this bulk composition, so it will appear empty. Verify individual compounds via the per-component cross-reference links. Underlying content was aggregated by FooDB from USDA / DTU / Phenol Explorer.",
  "data_release": "FooDB 2020-04-07 CSV release (foodb.ca/downloads)",
  "food_record": "https://foodb.ca/foods/FOOD00014",
  "verification": "expert-curated (multi-source food composition; growth-relevant profile completed, FooDB noise removed)",
  "curation_date": "2026-07-17",
  "curation_sources": [
   "USDA FoodData Central - Sugar-apples (sweetsop), raw (SR legacy NDB 09071)",
   "USDA FoodData Central - Custard-apple (bullock's-heart), raw (SR legacy NDB 09070)",
   "Elhassaneen et al. 2016, Arabian Journal of Chemistry - Postharvest physicochemical properties of pulp and seed oil from Annona squamosa (Gishta), Sudan",
   "Chowdhury et al. 2021, PMC7973736 - Nutritional, phytochemical and anticancer potential of Annona squamosa fruits",
   "Review of Nutrition, Bioactivities and Health Benefits of Custard Apple (Annona squamosa), MDPI Foods 2025, 14(19):3413 / PMC12523297",
   "FooDB FOOD00014 (Custard apple)"
  ],
  "curation_notes": "Dominant carbon/energy source is free sugars: near-equal glucose and fructose (reducing sugars ~18 g/100g) plus sucrose (~12 g/100g); citric acid is the dominant organic acid (~0.24 g/100g, pulp pH ~5.5) with minor malic/isocitric. Sugar totals vary strongly with ripeness (USDA total carbohydrate 23.6 g/100g vs 30 g/100g in ripe Sudan pulp). Vitamin/mineral panel anchored to USDA sweetsop (A. squamosa); removed model/gas species (CO2,O2,H+), preformed retinol, and ultratrace non-nutrient element",
  "curation_added": [
   "D-glucose (8.98 g/100g)",
   "D-fructose (8.98 g/100g)",
   "sucrose (12.47 g/100g)",
   "citric acid (dominant organic acid, 0.24 g/100g as titratable acidity)",
   "malic acid (present)",
   "total protein (2.0 g/100g)",
   "folate/B9 (14 ug/100g)",
   "manganese (0.4 mg/100g)",
   "selenium (0.6 ug/100g)"
  ],
  "curation_removed": [
   {
    "name": "Retinol",
    "reason": "Preformed (animal-form) vitamin A; custard apple pulp contains only trace provitamin-A carotenoids, not retinol (USDA vitamin A ~0). FooDB artifact."
   },
   {
    "name": "Nickel",
    "reason": "Non-nutritive ultratrace element; not a defined growth nutrient of this fruit."
   },
   {
    "name": "Co2+ (cobalt)",
    "reason": "Ultratrace; relevant only as B12 cofactor, and plant pulp has no meaningful cobalt/B12. FooDB trace, not a growth nutrient here."
   },
   {
    "name": "Molybdate",
    "reason": "Ultratrace element; not quantified as a nutrient of custard apple. FooDB trace."
   },
   {
    "name": "Fe2+ mitochondria",
    "reason": "Compartment-tagged model duplicate of iron; consolidated into a single 'iron' component."
   },
   {
    "name": "Iron (Fe3+)",
    "reason": "Redox/compartment duplicate of iron; consolidated into a single 'iron' component."
   },
   {
    "name": "CO2 CO2",
    "reason": "Gas-exchange/model metabolite, not a food nutrient contributed by the medium."
   },
   {
    "name": "O2 O2",
    "reason": "Gas-exchange/model metabolite, not a food nutrient."
   },
   {
    "name": "H+",
    "reason": "Proton/charge-balance model species, not a food nutrient (pH handled separately; pulp pH ~5.5)."
   },
   {
    "name": "Barium",
    "reason": "Non-nutritive trace contaminant reported in some analyses; not a growth nutrient. Drop."
   }
  ],
  "curation_confidence": "medium",

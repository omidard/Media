 "provenance": {
  "source_type": "literature",
  "citation": "Chindelevitch et al. MetaMerge: scaling up genome-scale metabolic reconstructions with application to Mycobacterium tuberculosis. Genome Biology (2012). DOI: 10.1186/gb-2012-13-1-r6. [PMC3488975]",
  "doi": "10.1186/gb-2012-13-1-r6",
  "url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3488975/",
  "notes": "Extracted from the primary paper (snippet: we enabled all the reactions corresponding to the import of elements of the Middlebrook medium, as previously done: ammonium, biotin, calcium, chloride, citrate, ferric iron, L-glutamic acid, phosphat). Component names mapped to BiGG (see mapping_confidence); presence-based bounds unless the paper gave exchange bounds; concentration_mM where units allowed. Extraction confidence: medium.",
  "verification": "paper-verified (corrected via workflow)",
  "verification_evidence": "we enabled all the reactions corresponding to the import of elements of the Middlebrook medium, as previously done: ammonium, biotin, calcium, chloride, citrate, ferric iron, L-glutamic acid, phosphate, potassium, sodium, and sulfate, with the addition of glycerol. Additionally, we added the following nutrients for growth from model 1: carbon dioxide, molybdenum, nitrogen dioxide, and oxygen. For ",
  "verification_confidence": "high",
